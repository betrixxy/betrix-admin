# betrix-studio üretim ortamı — bu dosyayı `.env.production` olarak kopyalayıp doldurun.
# `.env.production` gitignore'dadır; sunucuda `chmod 600 .env.production` yapın.
# Bkz. docker-compose.prod.yml ve CLAUDE.md 1.9.

# --- Alan adı + Cloudflare Tunnel ---
# Cloudflare Zero Trust → Networks → Tunnels → tünel → kurulum komutundaki token (eyJ… ile başlar).
CLOUDFLARE_TUNNEL_TOKEN=
APP_DOMAIN=studio.betrix.pro
# ACME_EMAIL artık kullanılmıyor: HTTPS sertifikasını Cloudflare yönetir.
# ACME_EMAIL=admin@betrix.pro

# --- PostgreSQL ---
# DATABASE_URL compose tarafından bu değerlerden üretilir. Şifre URL içine girdiği için
# yalnızca hex kullanın:  openssl rand -hex 32
POSTGRES_DB=betrix
POSTGRES_USER=betrix
POSTGRES_PASSWORD=

# --- Auth (zorunlu, en az 32 karakter — yoksa uygulama açılmaz) ---
# Geliştirme anahtarını KULLANMAYIN, yenisini üretin:  openssl rand -hex 32
JWT_SECRET=

# İlk kurulumda `prisma db seed` ile admin hesabını oluşturur.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Dış servisler ---
FAL_KEY=
# Claude — AI Market Tahmin stüdyosunun analist metinleri (boşsa kural tabanlı öneri)
ANTHROPIC_API_KEY=
SPORTMONKS_API_KEY=
API_FOOTBALL_KEY=
CHECKMATCH_MAC_SERVER_URL=
CHECKMATCH_API_SECRET=

# --- Sosyal medya OAuth + metrik senkronizasyonu (bkz. src/lib/services/social/) ---
# Dışarıdan erişilen kök adres; OAuth geri dönüş adresi bundan üretilir ve her sağlayıcının
# panelinde birebir kayıtlı olmalı:  https://<APP_DOMAIN>/api/auth/<instagram|facebook|tiktok|youtube|x>/callback
APP_BASE_URL=https://studio.betrix.pro
# OAuth token'larını veritabanında şifreler (AES-256-GCM). Üretimde zorunlu:  openssl rand -hex 32
# Değiştirilirse mevcut bağlantılar çözülemez — hesaplar yeniden bağlanmalı.
SOCIAL_TOKEN_ENCRYPTION_KEY=
# true: gerçek API'ye gidilmez, mock veri üretilir. Üretimde boş bırakın (varsayılan false).
# Açıkken Yayın Merkezi'nin "Hemen Paylaş"ı üretimde KAPALIDIR (sahte "yayınlandı" kaydı oluşmaz).
SOCIAL_USE_MOCKS=
#
# Yayın Merkezi — doğrudan paylaşım (Instagram + X). Ayrı token değişkeni YOKTUR: token'lar hesap
# "Etkileşim & Reklam → Bağla" ile alınır ve veritabanında şifreli tutulur (CLAUDE.md 4.4). Gerekenler:
#  - Meta uygulaması: Facebook Login for Business; izinler instagram_basic, instagram_content_publish,
#    instagram_manage_insights, pages_show_list, pages_read_engagement (canlı kullanım için uygulama
#    incelemesi). Instagram hesabı bir Facebook Sayfasına bağlı İşletme/İçerik Üreticisi hesabı olmalı.
#    Kısa ömürlü token bağlanırken ~60 günlük token'a çevrilir; süre dolunca hesap yeniden bağlanır.
#  - X uygulaması: OAuth 2.0 (Confidential client), izinler tweet.read tweet.write users.read media.write
#    offline.access; uygulama izni "Read and write".
#  - Instagram görseli kendisi indirir: paylaşım anında APP_BASE_URL/api/public-media altında 15 dk geçerli,
#    HMAC imzalı bir JPEG adresi üretilir (anahtar JWT_SECRET'tan türetilir). APP_BASE_URL internetten
#    erişilebilir olmalı.
# İzinler eklenmeden önce bağlanan hesaplar paylaşım için YENİDEN BAĞLANMALI.
# Meta (Instagram + Facebook aynı uygulama)
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# ---------- Otomatik metrik toplama (salt okuma — CLAUDE.md 1.10, 4.4) ----------
# scheduler servisi saatte bir /api/internal/metrics/tick'i bu sırla çağırır: openssl rand -hex 32
INTERNAL_CRON_SECRET=
# X API'den günde okunabilecek en fazla gönderi (kredi koruması, CLAUDE.md 4.5).
X_DAILY_READ_LIMIT=300

# --- /api/track ---
TRACK_ALLOWED_ORIGINS=https://checkmatch.net,https://www.checkmatch.net
TRACK_SITE_KEY=
