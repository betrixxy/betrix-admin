// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// CRM içerik planı — bkz. src/types/calendar.ts ContentPlan. Admin takvimde bir maç
/// için reklam bütçesi kaydettiğinde oluşur (app/calendar/actions.ts). fixtureId,
/// gerçek API-Football fikstürüne (`api-football-<id>`) referans verir; ayrı bir
/// Fixture tablosu yok, fikstür verisi her zaman API-Football'dan okunur.
model ContentPlan {
  id           String   @id @default(cuid())
  fixtureId    String   @unique
  scheduledFor DateTime
  /// AdPlatform[] — bkz. src/types/calendar.ts
  platforms    Json
  /// AdSpend — bkz. src/types/calendar.ts
  adSpend      Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Bu fikstür için üretilen platform bazlı somut gönderiler (bkz. SocialPost).
  socialPosts SocialPost[]
}

/// Tek admin hesabı — bkz. CLAUDE.md §1.6, yalnızca bu tablodaki kullanıcı
/// /login üzerinden giriş yapabilir (src/proxy.ts route koruması).
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// Bağlı sosyal medya hesabı/kanalı (bkz. CLAUDE.md Bölüm 4.1 — Meta/TikTok/YouTube/X).
/// Her fiziksel platform (Instagram, TikTok vb.) için tek bir kayıt tutulur; ileride
/// OAuth token'ları gibi hesap-bazlı bilgiler bu modele eklenir.
model SocialPlatform {
  id          String             @id @default(cuid())
  type        SocialPlatformType @unique
  displayName String
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  posts SocialPost[]
}

enum SocialPlatformType {
  META_INSTAGRAM
  META_FACEBOOK
  TIKTOK
  YOUTUBE
  X
}

/// Belirli bir platformda paylaşılan/paylaşılacak somut gönderi — sosyal gönderilerin TEK doğruluk kaynağı.
/// Takvimden planlanan (PREPARING), Yayın Merkezi'nden paylaşılan (PANEL, koşulsuz kayıt) ve platformdan
/// içe aktarılan (IMPORTED) gönderilerin hepsi burada durur (bkz. CLAUDE.md §4.4).
model SocialPost {
  id             String           @id @default(cuid())
  /// Hedeflenen maç — bkz. ContentPlan.fixtureId. İçe aktarılan gönderilerde maç bilinmediği için boş.
  fixtureId      String?
  contentPlanId  String?
  contentPlan    ContentPlan?     @relation(fields: [contentPlanId], references: [id], onDelete: SetNull)
  platformId     String
  platform       SocialPlatform   @relation(fields: [platformId], references: [id])
  caption        String
  /// Planlanan yayın zamanı; paylaşılmış/içe aktarılmış gönderide gerçek yayın zamanına eşittir.
  scheduledFor   DateTime
  publishedAt    DateTime?
  /// Hazırlanıyor / Paylaşıldı
  status         SocialPostStatus @default(PREPARING)
  /// Yayınlandıktan sonra platformun kendi post ID'si (metrik senkronizasyonu için).
  providerPostId String?
  /// Kayıt nereden geldi: panelden (takvim/Yayın Merkezi) mi, platformdan içe aktarma mı.
  source         PostSource       @default(PANEL)
  /// Gönderinin platformdaki herkese açık bağlantısı.
  permalink      String?
  mediaType      PostMediaType?
  /// Küçük görsel: panelden paylaşılanda `/api/files/...`, içe aktarılanda platformun (süreli) CDN adresi.
  thumbnailUrl   String?
  /// Gönderideki görseller sırasıyla (carousel/çoklu görsel).
  mediaUrls      String[]         @default([])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  analytics       PostAnalytics?
  features        PostFeatures?
  shortLink       ShortLink?
  metricSnapshots PostMetricSnapshot[]
  aiContents      AiContent[]
  trafficLogs     TrafficLog[]

  /// Aynı platform gönderisi iki kez kaydedilmez — içe aktarma idempotent.
  @@unique([platformId, providerPostId])
  @@index([fixtureId])
  @@index([scheduledFor])
  @@index([status])
  @@index([publishedAt])
}

enum SocialPostStatus {
  /// Hazırlanıyor
  PREPARING
  /// Paylaşıldı
  PUBLISHED
}

enum PostSource {
  /// Panelden oluşturuldu (takvim planı veya Yayın Merkezi paylaşımı)
  PANEL
  /// Platformdan "geçmiş gönderileri içe aktar" ile alındı
  IMPORTED
}

enum PostMediaType {
  /// Tek görsel
  IMAGE
  /// Kaydırmalı / çoklu görsel
  CAROUSEL
  VIDEO
  REELS
  STORY
  /// Yalnızca metin (X)
  TEXT
}

/// Yayınlanmış bir SocialPost'un platform metrikleri (bkz. CLAUDE.md §4.1 PostMetrics).
/// Post başına tek kayıt tutulur, kademeli senkronizasyonla (1s/6s/24s/72s) güncellenir
/// (`lib/services/social-metrics.ts`). Platformun vermediği metrik 0 kalır.
model PostAnalytics {
  id               String              @id @default(cuid())
  postId           String              @unique
  post             SocialPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  likes            Int                 @default(0)
  comments         Int                 @default(0)
  views            Int                 @default(0)
  shares           Int                 @default(0)
  /// Kaydetme / yer imi (IG saves, TikTok favorites, X bookmarks).
  saves            Int                 @default(0)
  /// Erişim — gönderiyi gören tekil hesap sayısı.
  reach            Int                 @default(0)
  /// Gösterim — toplam görüntülenme (aynı hesap birden çok kez sayılır).
  impressions      Int                 @default(0)
  /// Video toplam izlenme süresi (saniye) — YouTube/TikTok/Reels.
  watchTimeSeconds Int                 @default(0)
  /// Metriğin kaynağı: elle giriş, platform API'si veya geliştirme mock'u.
  source           PostAnalyticsSource @default(MANUAL)
  lastSyncedAt     DateTime            @default(now())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

/// Bir gönderinin belirli bir andaki metrikleri — zaman serisi (bkz. CLAUDE.md 4.4). Üzerine yazılmaz,
/// her çekim yeni satırdır; en son satır `PostAnalytics`'e "güncel değer" olarak yansıtılır.
/// Alanlar boş olabilir: null = platform bu metriği vermedi, 0 = gerçekten sıfır.
model PostMetricSnapshot {
  id                String        @id @default(cuid())
  socialPostId      String
  socialPost        SocialPost    @relation(fields: [socialPostId], references: [id], onDelete: Cascade)
  capturedAt        DateTime      @default(now())
  /// Çekim anında gönderinin yaşı (saat).
  ageHours          Float
  /// Karşılanan kontrol noktası ("1h", "6h", "24h", "72h", "7d", "30d", story "23h") ya da null (elle/içe aktarma).
  checkpoint        String?
  trigger           MetricTrigger
  likes             Int?
  comments          Int?
  shares            Int?
  saves             Int?
  reach             Int?
  views             Int?
  impressions       Int?
  profileVisits     Int?
  follows           Int?
  /// Bağlantı tıklaması (X url_link_clicks, IG story link_clicks).
  linkClicks        Int?
  /// X profil tıklaması (user_profile_clicks).
  profileClicks     Int?
  reposts           Int?
  quotes            Int?
  replies           Int?
  bookmarks         Int?
  totalInteractions Int?
  watchTimeSeconds  Int?
  /// X: PRIVATE = non_public/organic metrikler geldi (son 30 gün), PUBLIC = yalnızca public_metrics.
  metricLevel       MetricLevel?
  /// Sağlayıcının ham yanıtı (token içermez) — ileride yeni metrik türetmek için.
  raw               Json?

  @@index([socialPostId, capturedAt])
  @@index([capturedAt])
}

enum MetricTrigger {
  /// Otomatik kademeli takvim
  SCHEDULED
  /// Admin "şimdi güncelle"
  MANUAL
  /// İçe aktarma sırasında gelen ilk değerler
  IMPORT
}

enum MetricLevel {
  PUBLIC
  PRIVATE
}

enum PostAnalyticsSource {
  /// Admin tarafından elle girildi
  MANUAL
  /// Platform API'sinden senkronize edildi
  API
  /// Geliştirme ortamında mock adaptöründen üretildi — gerçek veri değil
  MOCK
}

/// Bir sosyal medya hesabının OAuth bağlantısı (bkz. CLAUDE.md §4.1). Platform başına tek hesap.
/// Token'lar AES-256-GCM ile şifreli saklanır (`lib/services/social/token-crypto.ts`) —
/// veritabanına asla düz metin token yazılmaz.
model SocialConnection {
  id            String             @id @default(cuid())
  platform      SocialPlatformType @unique
  /// Platformdaki hesap/sayfa/kanal kimliği.
  accountId     String
  accountName   String?
  /// Şifreli (iv.tag.ciphertext, base64url).
  accessToken   String
  /// Şifreli; platform yenileme token'ı vermiyorsa boş.
  refreshToken  String?
  expiresAt     DateTime?
  scopes        String[]
  lastSyncedAt  DateTime?
  /// Son senkronizasyon/yenileme hatası — başarılı senkronizasyonda temizlenir.
  lastSyncError String?
  connectedAt   DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

/// Fal.ai ile üretilen görsellerin kaydı (bkz. CLAUDE.md Bölüm 3 — birefnet/flux
/// pipeline'ları). `postId` boş olabilir: bir görsel, henüz hangi gönderide
/// kullanılacağı netleşmeden önce de üretilip depolanabilir; `fixtureId` ise her zaman
/// doludur — üretim her zaman belirli bir maç için tetiklenir (bkz. `types/calendar.ts`
/// `CalendarFixture.id`, henüz ayrı bir Fixture tablosu yok).
model AiContent {
  id             String      @id @default(cuid())
  fixtureId      String
  postId         String?
  post           SocialPost? @relation(fields: [postId], references: [id], onDelete: SetNull)
  prompt         String
  /// Arka planı temizlenmiş oyuncu fotoğrafı (bkz. CLAUDE.md 3.1 birefnet pipeline'ı).
  playerImageUrl String?
  /// Kullanıcının yüklediği özel marka/sponsor logosu — oyuncu fotoğrafından ayrı saklanır.
  logoImageUrl   String?
  resultImageUrl String?

  /// İnsan onaylı akış (human-in-the-loop): her üretim DRAFT doğar, admin önizleyip
  /// düzenledikten sonra APPROVED/REJECTED olur; Yayın Merkezi'nden paylaşılınca PUBLISHED — bkz. CLAUDE.md 1.10.
  status             AiContentStatus @default(DRAFT)
  /// StudioFormat (IG_FEED | STORY | X_CARD) — yeniden render için gerekli.
  format             String?
  /// Gönderi metni taslağı — gerçek istatistiklerden şablonla üretilir, admin düzenler.
  caption            String?
  /// Üretim anındaki gerçek maç verisi (MatchStats, API-Football) — onay ekranı ve denetim izi.
  statsSnapshot      Json?
  /// Görselde gösterilen istatistik seçimi + derbi tansiyonu (DraftRenderOptions).
  renderOptions      Json?
  /// Kalıcı depolamadaki Fal.ai `flux` arka planı — metin/istatistik düzenlemesinde
  /// Fal.ai'ye tekrar gitmeden (ücretsiz) yeniden render için saklanır.
  backgroundImageUrl String?
  reviewedAt         DateTime?
  /// İçerik türü kataloğundaki kimlik (ContentTypeId, bkz. lib/dashboard/content-types.ts) — ör. "MATCH_DAY".
  /// Katalogdan önceki genel stüdyo taslaklarında null.
  contentType        String?
  /// Planlanan yayın zamanı (UTC) — ileriye dönük içerik planlaması için; null = planlanmadı.
  publishAt          DateTime?
  /// Yayın Merkezi'nden API ile paylaşıldıysa: platform (PublishPlatform), gönderi kimliği, bağlantısı ve zamanı.
  publishedPlatform  String?
  publishedPostId    String?
  publishedUrl       String?
  publishedAt        DateTime?

  shortLink ShortLink?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([fixtureId])
  @@index([fixtureId, contentType])
  @@index([status])
  @@index([publishAt])
}

enum AiContentStatus {
  /// Onay bekliyor
  DRAFT
  /// Admin onayladı — yayına hazır
  APPROVED
  /// Admin reddetti
  REJECTED
  /// Yayın Merkezi'nden platforma API ile paylaşıldı (bkz. publishedUrl)
  PUBLISHED
}

/// checkmatch.net'e giden sosyal medya trafiğinin izlenmesi (bkz. CLAUDE.md §4.3 UTM
/// standardı). `postId` doldurulduğunda tıklama, kaynağı olan gönderiye kadar geriye
/// izlenebilir; doğrudan/organik trafik için boş bırakılır.
model TrafficLog {
  id                   String      @id @default(cuid())
  postId               String?
  post                 SocialPost? @relation(fields: [postId], references: [id], onDelete: SetNull)
  path                 String
  /// IP'nin HMAC-SHA256 özeti (`IP_HASH_SECRET`, sabit anahtar) — ham IP hiçbir tabloda tutulmaz.
  ipHash               String?
  /// Kalıcı ziyaretçi kimliği (snippet `cm_vid`, localStorage) — tekil/geri dönen ziyaretçi.
  sessionId            String?
  /// Oturum (ziyaret) kimliği (snippet `cm_sid`, sessionStorage + 30 dk hareketsizlik) — oturum bazlı atıf.
  visitId              String?
  isUniqueVisit        Boolean     @default(false)
  utmSource            String?
  utmMedium            String?
  utmCampaign          String?
  utmContent           String?
  utmTerm              String?
  /// UTM/gönderi bu sayfa görüntülemesinde yoktu, oturumun ilk ziyaretinden devralındı.
  attributionInherited Boolean     @default(false)
  visitedAt            DateTime    @default(now())

  @@index([postId])
  @@index([visitedAt])
  @@index([sessionId, visitedAt])
  @@index([visitId])
  @@index([utmSource])
}

/// Gönderi başına kısa link (bkz. CLAUDE.md 4.3): `<SHORT_LINK_BASE_URL>/r/<code>`. Yayın Merkezi'nde taslak için
/// üretilir (`aiContentId`), paylaşımda gönderiye bağlanır (`socialPostId`).
model ShortLink {
  id           String              @id @default(cuid())
  code         String              @unique
  socialPostId String?             @unique
  socialPost   SocialPost?         @relation(fields: [socialPostId], references: [id], onDelete: SetNull)
  aiContentId  String?             @unique
  aiContent    AiContent?          @relation(fields: [aiContentId], references: [id], onDelete: SetNull)
  platform     SocialPlatformType?
  /// İçerik türü (utm_campaign)
  contentType  String?
  /// checkmatch.net'teki hedef yol
  targetPath   String              @default("/")
  createdAt    DateTime            @default(now())

  clicks LinkClick[]
}

/// Kısa link tıklaması — ham IP yok (HMAC özeti), kaba bot filtresi işaretlenir (istatistikte sayılmaz).
model LinkClick {
  id           String              @id @default(cuid())
  shortLinkId  String
  shortLink    ShortLink           @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)
  socialPostId String?
  platform     SocialPlatformType?
  clickedAt    DateTime            @default(now())
  ipHash       String?
  isBot        Boolean             @default(false)
  referrerHost String?

  @@index([socialPostId, clickedAt])
  @@index([clickedAt])
}

/// Kalıcı medya/referans kütüphanesi (bkz. CLAUDE.md 1.11): stüdyoda her seferinde yükleme
/// yerine seçilebilen logolar, oyuncu fotoğrafları ve referans görseller. Dosya
/// `storage/library/<kategori>-<sha256>.<uzantı>` altında içerik-adresli tutulur; aynı dosya
/// aynı kategoriye ikinci kez eklenmez (`@@unique([category, sha256])`).
model MediaAsset {
  id          String        @id @default(cuid())
  /// "Klasör" — kütüphane arayüzü sekmeleri bu alana göre ayrılır.
  category    MediaCategory
  /// Admin'in verdiği görünen ad (ör. "Galatasaray logo — beyaz").
  label       String
  /// `/api/files/library/<dosya>` — yalnızca oturumlu admin'e servis edilir.
  fileUrl     String
  sha256      String
  contentType String
  width       Int
  height      Int
  sizeBytes   Int
  hasAlpha    Boolean       @default(false)
  /// Logolar için isteğe bağlı API-Football takım kimliği/adı — ileride maça göre otomatik seçim.
  teamId      String?
  teamName    String?
  /// Oyuncu fotoğrafları için API-Football oyuncu kimliği/adı — Maç Sonucu MVP'sinin fotoğrafı bununla bulunur.
  playerId    Int?
  playerName  String?
  /// Maç fotoğrafları (MATCH_PHOTO) için maç: "api-football-<id>" — Maç Sonucu fotoğrafı bununla otomatik bulunur.
  fixtureId   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([category, sha256])
  @@index([category])
  @@index([teamId])
  @@index([playerId])
  @@index([fixtureId])
}

enum MediaCategory {
  /// Takım / marka / sponsor logoları
  LOGO
  /// Oyuncu fotoğrafları (birefnet kesimine uygun, ≥1024px kısa kenar)
  PLAYER
  /// Stil / kompozisyon referans görselleri
  REFERENCE
  /// Tam kadraj maç fotoğrafları (Maç Sonucu) — maç (+ isteğe bağlı oyuncu) etiketli, ≥1080px kısa kenar önerilir
  MATCH_PHOTO
}

/// X API günlük okuma sayacı (UTC günü) — X ücreti dönen kaynak başınadır (bkz. CLAUDE.md 4.5).
/// `posts` `X_DAILY_READ_LIMIT` ile sınırlanır; sınıra gelince metrik işleri ertesi güne ertelenir.
model XReadUsage {
  /// UTC günü, `YYYY-MM-DD`
  day       String   @id
  requests  Int      @default(0)
  /// Okunan (dönen) gönderi sayısı
  posts     Int      @default(0)
  /// Okunan kullanıcı nesnesi sayısı (`/2/users/me`)
  users     Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// Hesap düzeyinde günlük metrikler (bkz. CLAUDE.md 4.4) — reklam görüşmeleri için takipçi büyümesi ve
/// günlük erişim. Geçmiş sonradan toplanamadığı için her gün kaydedilir; platform başına gün başına tek
/// satır (upsert). `date` İstanbul günüdür; etkileşim metrikleri o günü, takipçi sayısı gün bitiminden
/// hemen sonraki çekim anını gösterir. null = platform bu metriği vermedi.
model AccountMetricSnapshot {
  id                String             @id @default(cuid())
  platform          SocialPlatformType
  date              DateTime           @db.Date
  capturedAt        DateTime           @default(now())
  followerCount     Int?
  followingCount    Int?
  /// Toplam gönderi sayısı (IG media_count, X tweet_count)
  mediaCount        Int?
  reach             Int?
  views             Int?
  accountsEngaged   Int?
  totalInteractions Int?
  likes             Int?
  comments          Int?
  shares            Int?
  saves             Int?
  /// Profildeki bağlantı/iletişim düğmesi tıklamaları (IG profile_links_taps)
  profileLinksTaps  Int?
  follows           Int?
  unfollows         Int?
  /// İlk çalıştırmada geriye dönük doldurulan satır
  backfilled        Boolean            @default(false)
  raw               Json?

  @@unique([platform, date])
  @@index([date])
}

/// Kitle demografisi (haftalık) — Instagram follower_demographics / engaged_audience_demographics.
/// Meta eşiğin altındaki hesaplarda (ör. < 100 takipçi) vermez; o zaman `unavailableReason` dolu, `buckets` boştur.
model AudienceSnapshot {
  id                String             @id @default(cuid())
  platform          SocialPlatformType
  capturedAt        DateTime           @default(now())
  kind              AudienceKind
  /// Meta timeframe: this_week | this_month
  timeframe         String
  /// age | gender | city | country
  breakdown         String
  /// { "<kova>": sayı } — ör. { "18-24": 120, "25-34": 340 }
  buckets           Json?
  unavailableReason String?

  @@index([platform, capturedAt])
}

enum AudienceKind {
  /// Takipçiler
  FOLLOWER
  /// Etkileşime giren kitle
  ENGAGED
}

/// Gönderinin yayın anındaki analiz özellikleri (bkz. CLAUDE.md 4.4) — sonradan elde edilemeyen bağlam:
/// zaman, içerik, açıklama metni, maç bağlamı, paylaşım anındaki takipçi. "Hangi içerik / saat / kelime daha
/// çok etkileşim getiriyor" analizinin girdisi. Türetilmiş performans değerleri (oranlar) saklanmaz, okurken
/// snapshot'lardan hesaplanır (`lib/metrics/post-performance.ts`).
model PostFeatures {
  id                 String        @id @default(cuid())
  socialPostId       String        @unique
  socialPost         SocialPost    @relation(fields: [socialPostId], references: [id], onDelete: Cascade)
  /// Özellik çıkarma kurallarının sürümü — kurallar değişirse eski satırlar ayırt edilir.
  featureVersion     Int
  computedAt         DateTime      @default(now())
  /// İstanbul saatine göre 0–23
  publishedHourIst   Int
  /// ISO hafta günü, İstanbul: 1 = Pazartesi … 7 = Pazar
  weekdayIst         Int
  /// Yayın − başlama (saat): negatif = maçtan önce, pozitif = sonra. Maç bilinmiyorsa boş.
  hoursFromKickoff   Float?
  contentType        String?
  /// En-boy oranı: 4:5, 1:1, 9:16, 16:9
  format             String?
  templateName       String?
  mediaCount         Int
  captionChars       Int
  captionWords       Int
  hasQuestion        Boolean
  emojiCount         Int
  hashtags           String[]      @default([])
  hasLink            Boolean
  linkPlacement      LinkPlacement
  league             String?
  homeTeam           String?
  awayTeam           String?
  /// Derbi / büyük maç (derbyIntensity DERBY veya ELITE_DERBY)
  isDerby            Boolean?
  derbyIntensity     String?
  /// Paylaşım anına en yakın günlük hesap satırındaki takipçi sayısı
  followersAtPublish Int?
  /// Açıklama motoru bilgisi — sonraki fazda doldurulacak
  playbookVersion    String?
  captionModel       String?
  captionVariant     String?
}

enum LinkPlacement {
  /// Bağlantı gönderi metninde
  BODY
  /// Bağlantı ilk yanıtta (X)
  FIRST_REPLY
  NONE
}

/// Otomatik metrik toplama iş kuyruğu (salt okuma — bkz. CLAUDE.md 1.10, 4.4). Her (tür, hedef) için tek,
/// tekrarlayan satır: iş çalışınca bir sonraki zamanı (`nextRunAt`) hesaplanır. Saatlik `scheduler` servisi
/// `/api/internal/metrics/tick`'i çağırır; vadesi gelen işler `FOR UPDATE SKIP LOCKED` ile alınır, yani
/// üst üste binen iki tetikleme aynı işi iki kez çalıştırmaz. Bellek içi zamanlayıcı yoktur.
model MetricJob {
  id            String              @id @default(cuid())
  kind          MetricJobKind
  /// POST_METRICS: SocialPost.id · diğerleri: platform (SocialPlatformType)
  target        String
  platform      SocialPlatformType?
  status        MetricJobStatus     @default(PENDING)
  /// Art arda başarısız deneme sayısı (başarıda sıfırlanır)
  attempts      Int                 @default(0)
  nextRunAt     DateTime
  lockedAt      DateTime?
  lastRunAt     DateTime?
  lastSuccessAt DateTime?
  lastError     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([kind, target])
  @@index([status, nextRunAt])
}

enum MetricJobKind {
  POST_METRICS
  ACCOUNT_DAILY
  AUDIENCE_WEEKLY
  /// İlk çalıştırmada bir kez: geriye dönük hesap metrikleri
  ACCOUNT_BACKFILL
}

enum MetricJobStatus {
  PENDING
  RUNNING
  /// Takvim bitti (ör. 30 günlük gönderi) ya da hedef artık yok
  DONE
  /// Yeniden denemeler tükendi — panelde gösterilir, elle yeniden denenebilir
  FAILED
  /// Token/bağlantı sorunu — hesap yeniden bağlanınca kendiliğinden devam eder
  BLOCKED
}

/// Yıldızlı (takip edilen) maç — İçerik Planı yalnızca bunları listeler (bkz. CLAUDE.md 1.8).
/// Maç bilgisi yıldızlama anında sunucuda (API-Football) anlık görüntü olarak yazılır: liste
/// sağlayıcıya ulaşılamasa da çizilir; canlı durum/skor görünen maçlar için ayrıca tazelenir.
model WatchedFixture {
  id         String   @id @default(cuid())
  /// `api-football-<id>` (bkz. lib/services/api-football/mappers.ts::toFixtureId)
  fixtureId  String   @unique
  starredAt  DateTime @default(now())
  kickoffUtc DateTime
  homeName   String
  homeLogo   String
  awayName   String
  awayLogo   String
  leagueId   Int?
  leagueName String
  /// Sağlayıcının tur adı ("Regular Season - 9"); bilinmiyorsa null.
  round      String?

  @@index([kickoffUtc])
}

// ---------------------------------------------------------------------------
// Fotoğraf ARŞİVİ (bkz. CLAUDE.md 1.11) — Lig / Takım / mevki grubu / Kişi sanal klasörleri bu
// tablolardan türetilir; dosyalar fiziksel olarak taşınmaz. Adlar tek kaynaktan (API-Football +
// resmi ad tabloları, `lib/archive/names.ts`); elle yazılan serbest klasör adı yoktur.
// ---------------------------------------------------------------------------

/// Arşiv kökü: yurt içi lig ya da "Milli Takımlar" (isNational). Kimlik = API-Football league id.
model League {
  id           Int      @id
  officialName String
  country      String?
  logoUrl      String?
  /// Milli takım kökü (ağaçta en altta).
  isNational   Boolean  @default(false)
  /// Ağaç sırası (küçük önce); aynı sırada resmi ada göre tr-TR.
  sortOrder    Int      @default(100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teams Team[]
}

/// Takım — kimlik = API-Football team id. Ligi o sezonun yurt içi ligidir (küme düşen/çıkan takım
/// kendiliğinden yeni ligin altında görünür).
model Team {
  id              Int       @id
  officialName    String
  /// API-Football'un ham adı ("Besiktas") — resmi ad tablosunda yoksa kaynak.
  apiName         String
  logoUrl         String?
  country         String?
  national        Boolean   @default(false)
  currentLeagueId Int?
  currentLeague   League?   @relation(fields: [currentLeagueId], references: [id], onDelete: SetNull)
  /// Son kadro/teknik direktör senkronu; 7 gün içinde tekrar istek atılmaz.
  squadSyncedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  people         Person[] @relation("PersonCurrentTeam")
  nationalPeople Person[] @relation("PersonNationalTeam")
  pendingPeople  Person[] @relation("PersonPendingTeam")
  photos         Photo[]  @relation("PhotoTeam")
  kitPhotos      Photo[]  @relation("PhotoKitTeam")

  @@index([currentLeagueId])
}

enum PersonRole {
  PLAYER
  COACH
}

/// Mevki grubu — ağaçta sabit sırada: Kaleciler, Defans, Orta Saha, Forvet.
enum PersonPosition {
  GK
  DEF
  MID
  FWD
}

/// Oyuncu ya da teknik direktör. `apiId` API-Football oyuncu/teknik direktör kimliği (iki ayrı
/// sayı uzayı — `role` ile birlikte tekil).
model Person {
  id             String          @id @default(cuid())
  apiId          Int
  role           PersonRole
  position       PersonPosition?
  /// API-Football ham adı ("O. Kökçü").
  apiName        String
  /// Türetilmiş resmi tam ad ("Orkun Kökçü") — senkron yeniler.
  officialName   String
  /// Admin düzeltmesi ("resmi adı düzelt") — her zaman kazanır, senkron ezmez.
  nameOverride   String?
  currentTeamId  Int?
  currentTeam    Team?           @relation("PersonCurrentTeam", fields: [currentTeamId], references: [id], onDelete: SetNull)
  nationalTeamId Int?
  nationalTeam   Team?           @relation("PersonNationalTeam", fields: [nationalTeamId], references: [id], onDelete: SetNull)
  /// Senkron başka takım kadrosunda gördü — "taşınsın mı?" önerisi (otomatik taşıma YOK).
  pendingTeamId  Int?
  pendingTeam    Team?           @relation("PersonPendingTeam", fields: [pendingTeamId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  photos Photo[]

  @@unique([apiId, role])
  @@index([currentTeamId])
  @@index([nationalTeamId])
}

enum PhotoKind {
  CELEBRATION
  PORTRAIT
  ACTION
  TEAM
}

/// Arşiv fotoğrafı. Orijinal hiçbir zaman yeniden sıkıştırılmaz; kısa kenar < 2000 ise ayrıca
/// büyütülmüş sürüm tutulur (kart üretimi onu, arşiv orijinali gösterir).
model Photo {
  id            String    @id @default(cuid())
  /// null = takım fotoğrafı.
  personId      String?
  person        Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)
  /// Klasörün takımı (kulüp ya da milli takım). Transferde kulüp bağlamlı fotoğraflar yeni takıma geçer.
  teamId        Int
  team          Team      @relation("PhotoTeam", fields: [teamId], references: [id])
  /// Fotoğraftaki FORMANIN takımı — çekildiği andaki takım, transferde değişmez ("eski forma").
  kitTeamId     Int
  kitTeam       Team      @relation("PhotoKitTeam", fields: [kitTeamId], references: [id])
  /// `api-football-<id>`; maç fotoğrafıysa.
  fixtureId     String?
  kind          PhotoKind
  caption       String    @default("")
  /// Kaynak / fotoğrafçı.
  credit        String    @default("")
  takenAt       DateTime?
  uploadedAt    DateTime  @default(now())
  /// `/api/files/library/...` — yüklenen baytlar olduğu gibi.
  originalUrl   String
  /// Kısa kenarı 2000'e büyütülmüş sürüm (Fal ESRGAN, önbellekli); gerekmiyorsa ya da henüz yoksa null.
  upscaledUrl   String?
  sha256        String
  contentType   String
  width         Int
  height        Int
  sizeBytes     Int
  /// Arşivden silindi (gizlendi) — dosya ve kullanılmış kartlar bozulmaz.
  hiddenAt      DateTime?
  /// Taşınan eski `MediaAsset` kaydı (veri kaybı yok; eski kayıt silinmez).
  legacyAssetId String?   @unique
  updatedAt     DateTime  @updatedAt

  @@unique([sha256, personId, teamId])
  @@index([personId])
  @@index([teamId])
  @@index([fixtureId])
  @@index([kitTeamId])
}
